  "main": "index.js",
  "scripts": {
    "docker:build": "docker build -t playwright-tests .",
    "docker:run": "docker run -it --rm -v $PWD/reports:/app/reports playwright-tests",
    "test:docker": "npm run docker:build && npm run docker:run",
    "test:local": "npx playwright test",
    "test:tag": "npx playwright test --grep @TAG",
    "reports": "npx playwright show-report reports",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
