  "dependencies": {
    "@playwright/test": "^1.51.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "dotenv": "^16.5.0",
    "prettier": "3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
